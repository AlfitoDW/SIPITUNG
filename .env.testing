APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=null
LOG_LEVEL=critical

# Pakai SQLite memory supaya test TIDAK menyentuh DB MySQL utama
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

